misty subprogram tokenize() {

# 2026-07-21

# This subprogram returns a function that takes a text and converts it into an
# array of tokens. The argument is a source text. The return value is an array
# of token records.

# A token record contains
#       kind
#       text
#       at
#       from_column
#       from_row
#       to_column
#       to_row
#       indentation (only on long text and space)
# Only when a token contains an error
#       error
#       error_at
#       error_column
#       error_row

# A kind includes
#       name
#       number
#       text
#       space
#       newline
#       comment
#       operator
#       apostrophic

# Tokenize can recognize many punctuators that are not legal Misty tokens.
# In particular, some special characters can be repeated and followed by
# equal signs. Misty does a little of this. The C family does this a lot.

# Characters outside of the ASCII set that are not enclosed in text
# literals are encoded as single character punctuators.

# A comment token includes '#', all of the characters following it up to
# but not including the end of line, and all the spaces that proceeded it.

# An apostrophic token has a text of three of more characters, and the first
# and last are ''' (apostrophe). These are used for Misty functinos and
#  McKeeman singletons.

# Tokenize does not directly report errors. It always completes the file.
# If there is an error in a name or number, it makes a token containing
# 'error', 'error_at', 'error_row', and 'error_column' fields.

    def backslash: "\b"
    def car_reg: "\r"
    def end_of_line: "\n"
    def quote: "\q"

    def escape: {
        a: "&"
        b: backslash
        g: ">"
        l: "<"
        n: end_of_line
        q: quote
        r: car_reg
        t: "\t"
    }

    def hex: {
        "0": true
        "1": true
        "2": true
        "3": true
        "4": true
        "5": true
        "6": true
        "7": true
        "8": true
        "9": true
        "A": true
        "B": true
        "C": true
        "D": true
        "E": true
        "F": true
    }

    var at: 0
    var column_nr: 0
    var indent: 0
    var indentation: 0
    var row_nr: 0
    var source: ""
    var token: null
    var tokenators: null

    def error(reason) {
        if null?(token.error)
            assign token.error: reason
            assign token.error_at: at
            assign token.error_row: row_nr
            assign token.error_column: column_nr
        fi
    }

    def peek(ahead | 0) {
        return source[at + ahead]
    }

    def advance() {
        assign at: at + 1
        assign column_nr: column_nr + 1
    }

    def snip(
        trim_front | 0
        trim_back | 0
    ) {
        return text(
            source
            token.at + trim_front
            at - trim_back
        )
    }

    def seal() {
        assign token.text: snip()
        assign token.kind: "operator"
    }

    def repeatable(character) {
        if peek() = character
            call advance()
            jump repeatable(character)
        fi
    }

    def cish() {

# The character can be repeated and may also be appended with one or more
# equal signs.

        call repeatable(peek(-1))
        call repeatable("=")
        call seal()
    }

    def ender(character) {
        return character = end_of_line \/ character = car_reg \/ character = ""
    }

    def newline() {
        assign token.kind: "newline"
        assign token.text: end_of_line
        assign column_nr: 0
        assign row_nr: row_nr + 1
    }

    def carriage_return() {
        assign token.kind: "newline"
        if peek() = end_of_line
            call advance()
            assign token.text: car_reg + end_of_line
        else
            assign token.text: car_reg
        fi
        assign column_nr: 0
        assign row_nr: row_nr + 1
    }

    def comment() {
        if not(ender(peek()))
            call advance()
            jump comment()
        fi
        assign token.kind: "comment"
        assign token.text: snip()
    }

    def space() {
        call repeatable(" ")
        if peek() = "#"
            return comment()
        fi
        assign token.kind: "space"
        assign token.text: snip()
        assign token.length: token.text.length
        if token.from_column = 0
            assign indentation: token.length
            assign token.indentation: indentation
        fi
    }

    def digit() {

        def int(must) {
            if tokenators[peek()] = digit
                call advance()
                return int()
            fi
            if must
                call error("Expected a digit after '" & peek(-1) & "'.")
            fi
            if peek() = "_"
                call advance()
                return int(true)
            fi
        }

        call int()
        if peek() = "."
            call advance()
            call int(true)
        fi
        if peek() = "e"
            call advance()
            if peek() = "-"
                call advance()
            else if peek() = "+"
                call advance()
                call error("Unexpected '+'.")
            fi
            call int(true)
        fi
        assign token.kind: "number"
        assign token.text: snip()
        assign token.number: number(token.text)
        if null?(token.number)
            call error("Bad number '" + token.text + "'.")
        fi
    }

    def minus() {
        if tokenators[peek()] = digit
            return digit()
        fi
        call repeatable("-")
        call repeatable("=")
        return seal()
    }

    def slash() {
        if peek() = backslash
            call advance()
        else
            call repeatable("/")
            call repeatable("=")
        fi
        return seal()
    }

    def equal() {
        call repeatable("=")
        call repeatable(">")
        return seal()
    }

    def left_bracket() {
        if peek() = "]"
            call advance()
        fi
        return seal()
    }

    def reverse_solidus() {
        if peek() = "/"
            call advance()
        fi
        return seal()
    }

    def less() {
        if peek() = ">"
            call advance()
        else
            call repeatable("<")
            call repeatable("=")
        fi
        return seal()
    }

    def letter() {
        def alphameric(character) {
            def tokenator: tokenators[character]
            return tokenator = letter \/ tokenator = digit
        }

        def middle() {
            if alphameric(peek())
                call advance()
                return middle()
            fi
            if peek() = "_"
                if alphameric(peek(1))
                    call advance()
                    call advance()
                    return middle()
                fi
            fi
        }

        call middle()
        if peek() = "?"
            call advance()
        fi
        assign token.kind: "name"
        assign token.text: snip()
    }

    def single_quote() {
        if ender(peek())
            call error("Missing '''.")
        else
            call advance()
            if peek(-1) <> "'"
                jump single_quote()
            fi
        fi
        assign token.kind: "apostrophic"
        assign token.text: snip()
    }

    def count_spaces(total | 0) {
        if peek() <> " "
            return total
        fi
        call advance()
        jump count_spaces(total + 1)
    }

    def line(content) {
        if ender(peek())
            return content
        fi
        call advance()
        jump line(content & peek(-1))
    }

    def next_line(lines | []) {
        if peek() = car_reg /\ peek(1) = end_of_line
            assign at: at + 1
        fi
        call advance()
        assign column_nr: 0
        assign row_nr: row_nr + 1
        assign indent: count_spaces()
        if indent >= indentation + 4
            assign lines[]: line(repeat(" " indent - (indentation + 4)))
            jump next_line()
        fi
        return lines
    }

    def long() {
        assign token.text: text(next_line() end_of_line)
        if indent <> indentation
            call error(
                "Expected" && indentation &&
                "spaces and saw" && indent && "spaces."
            )
        fi
        if peek() = quote
            call advance()
        else
            call error("
                Missing '"'.
            ")
        fi
        assign token.kind: "text"
        assign token.indentation: indentation
    }

    def hex_text(accumulation) {
        if hex[peek()] <> true
            return accumulation
        fi
        call advance()
        jump hex_text(accumulation & peek(-1))
    }

    def text_guts(accumulation) {
        var escapee: ""
        var codepoint: 0

# End of text

        if peek() = quote
            call advance()
            return accumulation
        fi

# End of line

        if ender(peek())
            call error("
                Missing '"'.
            ")
            return accumulation
        fi

# Accumulate a character

        if peek() <> backslash
            call advance()
            jump text_guts(accumulation & peek(-1))
        fi

# Escapement

        call advance()
        assign escapee: escape[peek()]

# Simple escapement

        if text?(escapee)
            call advance()
            jump text_guts(accumulation & escapee)
        fi

# Bad escapement

        if peek() <> "u"
            call error("Bad escapement '" & backslash & peek() & "'.")
            call advance()
            jump text_guts(accumulation)
        fi

# Unicode hex codepoint escapement

        call advance()
        if peek() = "{"
            call advance()
        else
            call error("Missing '{'.")
        fi
        assign escapee: hex_text("")
        if escapee = ""
            call error("Missing codepoint.")
        fi
        assign codepoint: number(escapee 16)
        if (
            int?(codepoint) /\
            codepoint <= 4294967295 /\
            codepoint >= 0
        )
            assign escapee: character(codepoint)
        else
            call error("Bad codepoint" && escapee)
            assign escapee: ""
        fi
        if peek() = "}"
            call advance()
        else
            call error("Missing '}'.")
        fi
        jump text_guts(accumulation & escapee)
    }

    def double_quote() {
        if ender(peek())
            jump long()
        fi
        assign token.kind: "text"
        assign token.text: text_guts("")
    }

    assign tokenators: {
        "\n": newline
        "\r": carriage_return
        " ": space
        "#": comment
        "/": slash
        "\b": reverse_solidus
        "|": cish
        "&": cish
        "\q": double_quote
        "'": single_quote
        "-": minus
        "+": cish
        "*": cish
        "=": equal
        ":": cish
        "[": left_bracket
        "<": less
        ">": cish
        "!": cish
        "^": cish
        "%": cish
        "0": digit
        "1": digit
        "2": digit
        "3": digit
        "4": digit
        "5": digit
        "6": digit
        "7": digit
        "8": digit
        "9": digit
        "A": letter
        "B": letter
        "C": letter
        "D": letter
        "E": letter
        "F": letter
        "G": letter
        "H": letter
        "I": letter
        "J": letter
        "K": letter
        "L": letter
        "M": letter
        "N": letter
        "O": letter
        "P": letter
        "Q": letter
        "R": letter
        "S": letter
        "T": letter
        "U": letter
        "V": letter
        "W": letter
        "X": letter
        "Y": letter
        "Z": letter
        "a": letter
        "b": letter
        "c": letter
        "d": letter
        "e": letter
        "f": letter
        "g": letter
        "h": letter
        "i": letter
        "j": letter
        "k": letter
        "l": letter
        "m": letter
        "n": letter
        "o": letter
        "p": letter
        "q": letter
        "r": letter
        "s": letter
        "t": letter
        "u": letter
        "v": letter
        "w": letter
        "x": letter
        "y": letter
        "z": letter
    }

    def next_token(tokens | []) {
        if peek() = ""
            return tokens
        fi
        assign token: {
            at
            from_column: column_nr
            from_row: row_nr
        }
        var tokenator: tokenators[peek()]
        call advance()
        if function?(tokenator)
            call tokenator()
        else
            call seal()
        fi
        assign token.to_column: column_nr
        assign token.to_row: row_nr
        assign tokens[]: token
        jump next_token(tokens)
    }

    return function tokenize(source_text) {
        assign source: source_text
        assign at: 0
        assign row_nr: 0
        assign column_nr: 0
        jump next_token()
    }
}
